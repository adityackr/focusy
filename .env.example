[TEMPLATE]
# The YouTube Data API v3 key is entered by the user in the app under
# Settings (/settings) and stored only in that browser's localStorage.

# Optional — SEO only. The production origin used for metadataBase, canonical
# URLs, sitemap.xml, robots.txt and OpenGraph links. Defaults to the deployed
# Vercel domain; set it when the app is served from a custom domain.
# NEXT_PUBLIC_SITE_URL=https://focusy.example.com

# Optional — Google Search Console verification. Paste the "content" value of
# the HTML meta tag Search Console gives you (Settings → Ownership
# verification → HTML tag) and redeploy. Emits
# <meta name="google-site-verification" ...> on every page.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token
